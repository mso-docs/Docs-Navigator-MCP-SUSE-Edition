# ---- Search --------------------------------------------------------------
# auto     semantic search with an embedding model, falling back to keyword search
# lexical  keyword search only (SQLite FTS5). No embedding model, no network.
# semantic embeddings only
SEARCH_MODE=lexical

# ---- AI answers (optional) -----------------------------------------------
# none | ollama | huggingface | openai | anthropic
# Search and the MCP tools work with "none"; ask_question then returns the best passages.
AI_PROVIDER=none

# Ollama (local, free). Also used for embeddings when SEARCH_MODE is auto or semantic.
# AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
EMBEDDING_MODEL=nomic-embed-text

# Hugging Face Inference Providers (open models, billed to your own Hugging Face account).
# The token needs the "Make calls to Inference Providers" permission.
# AI_PROVIDER=huggingface
# HF_TOKEN=
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# OpenAI or Anthropic (paid, optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Use a different provider for embeddings only (ollama or openai)
# EMBEDDING_PROVIDER=ollama

# ---- Web UI ---------------------------------------------------------------
PORT=3000

# ---- Data locations (defaults shown) --------------------------------------
# LEXICAL_DB_PATH=./data/lexical.db
# VECTOR_DB_PATH=./data/vectors
# PAGE_CACHE_PATH=./data/page-cache.db
