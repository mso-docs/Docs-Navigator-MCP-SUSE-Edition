{
  "name": "docs-navigator-mcp-suse",
  "version": "2.0.0",
  "description": "MCP server and web UI for searching SUSE, Rancher, K3s, RKE2, Longhorn, Harvester, NeuVector and Kubewarden documentation. Community project, not an official SUSE product.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "web": "node src/web-server.js",
    "test": "node src/tests/test-offline.js",
    "index": "node src/cli/index-docs.js",
    "stats": "node src/cli/index-docs.js --stats",
    "clear-cache": "node src/cli/index-docs.js --clear-cache all",
    "validate": "node src/cli/index-docs.js --validate-cache",
    "rebuild": "node src/cli/index-docs.js --rebuild-source",
    "fix-sources": "node src/utils/fix-cache-sources.js",
    "mark-indexed": "node src/utils/mark-indexed.js",
    "migrate-sqlite": "node src/utils/migrate-to-sqlite.js",
    "analytics": "node src/cli/cache-analytics.js",
    "query-cache": "node src/cli/query-cache.js",
    "clear-locks": "node src/cli/clear-locks.js",
    "check-changes": "node src/cli/check-changes.js",
    "test:ollama": "node src/tests/test.js",
    "build-demo": "node scripts/build-demo-index.js",
    "build-sample": "node scripts/build-sample-answer.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "suse",
    "rancher",
    "k3s",
    "rke2",
    "documentation",
    "search"
  ],
  "author": "Mackenzie O'Brien <Mac Labs AI>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "axios": "1.21.1",
    "better-sqlite3": "13.2.0",
    "cheerio": "1.2.0",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "ollama": "0.6.4",
    "openai": "7.57.0",
    "p-limit": "7.3.3",
    "turndown": "7.2.5",
    "vectra": "0.15.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mso-docs/Docs-Navigator-MCP-SUSE-Edition.git"
  },
  "homepage": "https://mso-docs.github.io/Docs-Navigator-MCP-SUSE-Edition/"
}
